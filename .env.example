# Generate .env using: node scripts/setup.mjs
# Never commit local values. Both Compose and scripts/run.mjs read root .env.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=campus_loop_dev
DB_USERNAME=campus_loop
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
SERVER_PORT=8088
UPLOAD_DIR=.local/uploads
CAMPUS_BOOTSTRAP_ENABLED=false
CAMPUS_REGISTRATION_MODE=CLOSED
CAMPUS_ADMIN_USERNAME=
CAMPUS_ADMIN_PASSWORD=
CAMPUS_USER_USERNAME=
CAMPUS_USER_PASSWORD=

# Single-instance application rate limits. Forwarded addresses are ignored unless the direct proxy is listed.
CAMPUS_RATE_LIMIT_ENABLED=true
CAMPUS_RATE_LIMIT_MAX_KEYS=10000
CAMPUS_RATE_LIMIT_TRUSTED_PROXIES=
CAMPUS_RATE_LIMIT_LOGIN_LIMIT=10
CAMPUS_RATE_LIMIT_LOGIN_WINDOW=1m
CAMPUS_RATE_LIMIT_REGISTRATION_LIMIT=5
CAMPUS_RATE_LIMIT_REGISTRATION_WINDOW=10m
CAMPUS_RATE_LIMIT_PASSWORD_LIMIT=5
CAMPUS_RATE_LIMIT_PASSWORD_WINDOW=10m
CAMPUS_RATE_LIMIT_UPLOAD_LIMIT=20
CAMPUS_RATE_LIMIT_UPLOAD_WINDOW=1m

# Exchange expiry: backend only; durable deadlines/retries remain in MySQL.
CAMPUS_EXCHANGE_EXPIRY_ENABLED=true
CAMPUS_EXCHANGE_EXPIRY_BATCH_SIZE=50
CAMPUS_EXCHANGE_EXPIRY_DELAY_MS=30000
CAMPUS_EXCHANGE_EXPIRY_INITIAL_DELAY_MS=1000

# Email-verified public registration: set EMAIL_VERIFIED after SMTP delivery is verified.
# SMTP credentials stay on the backend. 465 uses implicit TLS; other ports require STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
CAMPUS_PUBLIC_URL=https://amoewell.top
