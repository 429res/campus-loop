# All VITE_* variables are public and bundled into the browser/mini-program.
# H5 uses the local Vite proxy when empty. Set a public HTTPS API origin for deployment.
VITE_API_BASE_URL=
VITE_API_PROXY=http://127.0.0.1:8088
# Optional local H5 port. Set through environment instead of repeating CLI --port flags.
VITE_DEV_PORT=5175
# Mini-program defaults to http://127.0.0.1:8088 for the desktop developer tool.
# For a device use a reachable HTTPS API, configure the WeChat server domain, then rebuild.
VITE_MINI_API_BASE_URL=http://127.0.0.1:8088
VITE_WECHAT_APP_ID=
